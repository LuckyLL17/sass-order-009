{
  "name": "subhub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SubHub 订阅工具聚合平台后端 API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "verify": "node scripts/verify-api.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.12.0",
    "zod": "^3.24.1"
  }
}
