# 服务端口
PORT=4000

# SQLite 数据库文件路径（相对于 server 目录）
DATABASE_FILE=./data/subhub.db

# JWT 签名密钥（生产环境请务必替换为随机长字符串）
JWT_SECRET=subhub-dev-secret-change-me-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 允许的前端来源（多个用逗号分隔），* 表示允许所有来源
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 节点环境
NODE_ENV=development
