# 服务端口
PORT=4000

# 前端地址，多个来源用逗号分隔；* 表示允许所有来源（仅开发环境）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT 密钥（生产环境务必修改）
JWT_SECRET=subhub-dev-secret-change-me-2026
# Token 有效期
JWT_EXPIRES_IN=7d

# SQLite 数据库文件（sql.js 持久化文件）
DATABASE_FILE=./data/subhub.sqlite
# 同步落盘间隔（毫秒）
DB_FLUSH_INTERVAL_MS=2000

# 种子测试账户（执行 npm run seed 后可直接登录）
SEED_USER_NAME=演示用户
SEED_USER_EMAIL=demo@subhub.local
SEED_USER_PASSWORD=demo1234
